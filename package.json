{
  "name": "niramay-digital-government-health-network",
  "version": "1.0.0",
  "private": true,
  "description": "SIH government hospital workflow prototype",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node server.js --seed",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "api:dev": "tsx apps/api/src/server.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
